#!/usr/bin/env bash
# Continúa tu última conversación de Claude Code usando el router gratuito (FreeLLMAPI) como backend.
# Uso: scripts/claude-free            (retoma la última sesión de este directorio)
#      scripts/claude-free --resume   (elige una sesión)
# Requiere: FREELLMAPI_API_KEY (unified key del dashboard).
set -euo pipefail
: "${FREELLMAPI_API_KEY:?Define FREELLMAPI_API_KEY con la unified key (http://localhost:3001 → Keys)}"
URL="${FREELLMAPI_URL:-http://localhost:3001}"
"$(dirname "$0")/freellm-start.sh" >/dev/null
ARGS=("$@"); [ ${#ARGS[@]} -eq 0 ] && ARGS=(--continue)
unset ANTHROPIC_API_KEY
export ANTHROPIC_BASE_URL="$URL" ANTHROPIC_AUTH_TOKEN="$FREELLMAPI_API_KEY"
export ANTHROPIC_MODEL=auto ANTHROPIC_DEFAULT_OPUS_MODEL=auto ANTHROPIC_DEFAULT_SONNET_MODEL=auto ANTHROPIC_DEFAULT_HAIKU_MODEL=auto
exec claude "${ARGS[@]}"
